{
  "manifest_version": 3,
  "name": "Hirenova Auto-Apply & Resume Agent",
  "version": "1.2",
  "description": "1-Click autofill job applications on Greenhouse, Lever, Workday, and ATS platforms with local resume file auto-attachment.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "autofill_one_go": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "1-Go Autofill Form & Attach Resume"
    },
    "toggle_overlay": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "Command+Q"
      },
      "description": "Hide / Toggle Extension Overlay"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
